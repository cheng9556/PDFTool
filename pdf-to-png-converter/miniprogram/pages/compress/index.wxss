.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8f8f8;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 上传区域 */
.upload-area {
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  background: #fafafa;
  margin-bottom: 32rpx;
  transition: all 0.3s;
}

.upload-area:active {
  background: #f0f6ff;
  border-color: #1a6dff;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.upload-text {
  font-size: 28rpx;
  color: #1a6dff;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

/* 文件信息 */
.file-info {
  background: #f0f7ff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.file-details {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #666;
}

.file-change {
  color: #1a6dff;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #1a6dff;
  border-radius: 8rpx;
}

/* 压缩级别选择 */
.compression-section {
  margin-top: 32rpx;
}

.compression-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.compression-levels {
  margin-bottom: 40rpx;
}

.level-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.level-item.selected {
  background: #f0f7ff;
  border-color: #1a6dff;
}

.level-radio {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.level-item.selected .level-radio {
  border-color: #1a6dff;
}

.radio-dot {
  width: 24rpx;
  height: 24rpx;
  background: #1a6dff;
  border-radius: 50%;
}

.level-info {
  flex: 1;
}

.level-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.level-desc {
  font-size: 24rpx;
  color: #666;
}

.level-ratio {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a6dff;
  margin-left: 20rpx;
}

/* 压缩按钮 */
.compress-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1a6dff 0%, #0052d9 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  margin-top: 20rpx;
}

.compress-btn::after {
  border: none;
}

.compress-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}

/* 处理结果 */
.result {
  margin-top: 32rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  background: #52c41a;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  margin: 0 auto 20rpx;
}

.success-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.result-stats {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.dot {
  color: #d9d9d9;
}

/* 结果信息 */
.result-info {
  background: #f8f8f8;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #666;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.info-value.highlight {
  color: #1a6dff;
  font-weight: 600;
}

.result-file {
  background: #f0f7ff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.file-item-info {
  display: flex;
  flex-direction: column;
}

.file-item-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-item-meta {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.download-all-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1a6dff 0%, #0052d9 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  margin-bottom: 24rpx;
}

.download-all-btn::after {
  border: none;
}

.reset-btn {
  text-align: center;
  color: #1a6dff;
  font-size: 28rpx;
  padding: 20rpx;
}

