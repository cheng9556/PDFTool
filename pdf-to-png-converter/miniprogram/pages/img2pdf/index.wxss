.wrap { padding: 24rpx; padding-bottom: 140rpx; }
.panel { background: #fff; border-radius: 16rpx; padding: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05); }
.h1 { font-size: 32rpx; font-weight: 700; margin-bottom: 12rpx; }
.tips { background: #f0f6ff; color: #3b82f6; padding: 16rpx; border-radius: 12rpx; font-size: 26rpx; }
.tips view { margin: 6rpx 0; }

/* 操作按钮区域 */
.action-buttons { display: flex; gap: 20rpx; margin-top: 20rpx; }
.uploader { 
  width: 200rpx; 
  height: 160rpx; 
  border: 2rpx dashed #3b82f6; 
  color: #3b82f6; 
  border-radius: 16rpx; 
  display: flex; 
  flex-direction: column;
  align-items: center; 
  justify-content: center; 
}
.uploader text:first-child { font-size: 48rpx; }
.uploader-text { font-size: 24rpx; margin-top: 8rpx; }

/* 重新选择按钮 */
.clear-btn { 
  width: 200rpx; 
  height: 160rpx; 
  border: 2rpx dashed #ef4444; 
  color: #ef4444; 
  border-radius: 16rpx; 
  display: flex; 
  flex-direction: column;
  align-items: center; 
  justify-content: center; 
}
.clear-btn text:first-child { font-size: 48rpx; }
.clear-text { font-size: 24rpx; margin-top: 8rpx; }

/* 图片预览区域 */
.thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 20rpx; }
.thumb-wrapper { position: relative; }
.thumb { width: 100%; height: 200rpx; border-radius: 12rpx; }

/* 删除按钮 */
.remove-btn { 
  position: absolute; 
  top: -10rpx; 
  right: -10rpx; 
  width: 44rpx; 
  height: 44rpx; 
  background: #ef4444; 
  color: #fff; 
  border-radius: 50%; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-size: 28rpx; 
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}

/* 图片序号 */
.thumb-index { 
  position: absolute; 
  bottom: 8rpx; 
  left: 8rpx; 
  background: rgba(0,0,0,0.6); 
  color: #fff; 
  font-size: 22rpx; 
  padding: 4rpx 12rpx; 
  border-radius: 8rpx; 
}

.footer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; padding: 20rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05); }


