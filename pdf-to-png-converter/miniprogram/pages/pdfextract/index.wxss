.wrap {
  padding: 24rpx;
  padding-bottom: 40rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 上传面板 */
.panel {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.h1 {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #333;
}

.tips {
  background: #f0f6ff;
  color: #3b82f6;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.tips view {
  margin: 6rpx 0;
}

.upload-area {
  margin: 32rpx 0;
  padding: 60rpx 40rpx;
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  text-align: center;
  background: #fafafa;
  transition: all 0.3s;
}

.upload-area:active {
  background: #f0f6ff;
  border-color: #1a6dff;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.upload-text {
  font-size: 28rpx;
  color: #1a6dff;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

/* 内容区域 */
.content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 文件信息栏 */
.file-info-bar {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.file-info-text {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  font-size: 24rpx;
  color: #999;
}

.file-change {
  color: #3b82f6;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #3b82f6;
  border-radius: 8rpx;
}

/* 预览面板 */
.preview-panel {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.preview-header {
  padding: 20rpx 24rpx;
  background: #fafbfc;
  border-bottom: 1rpx solid #e5e7eb;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
}

.preview-image-wrapper {
  padding: 24rpx;
  background: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}

.preview-image {
  width: 100%;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 缩略图面板 */
.thumbnails-panel {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.thumbnails-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
  padding: 0 24rpx 16rpx;
}

.thumbnails-scroll {
  white-space: nowrap;
}

.thumbnails-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 24rpx;
}

.thumbnail-item {
  display: inline-block;
  width: 120rpx;
  text-align: center;
}

.thumbnail-img {
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e5e7eb;
  background: #f9fafb;
}

.thumbnail-item.active .thumbnail-img {
  border-color: #3b82f6;
  box-shadow: 0 0 0 2rpx #3b82f6;
}

.thumbnail-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.thumbnail-item.active .thumbnail-label {
  color: #3b82f6;
  font-weight: 600;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 10rpx 0;
}

.action-btn {
  flex: 1;
  background: #fff;
  border: 2rpx solid #3b82f6;
  border-radius: 12rpx;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.1);
}

.action-btn:disabled {
  opacity: 0.5;
}

.btn-icon {
  font-size: 48rpx;
}

.btn-text {
  font-size: 26rpx;
  color: #3b82f6;
  font-weight: 500;
}

/* 文本结果 */
.text-result {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.text-result-header {
  font-size: 26rpx;
  font-weight: 600;
  color: #16a34a;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.text-result-content {
  font-size: 26rpx;
  line-height: 1.8;
  color: #333;
  max-height: 400rpx;
  overflow-y: auto;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.modal-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  border: 2rpx solid #e5e7eb;
}

.modal-option:active {
  background: #f0f1f3;
}

.option-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.option-info {
  flex: 1;
}

.option-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

.modal-cancel {
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

