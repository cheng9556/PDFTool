.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8f8f8;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 上传区域 */
.upload-area {
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  background: #fafafa;
  margin-bottom: 32rpx;
  transition: all 0.3s;
}

.upload-area:active {
  background: #f0f6ff;
  border-color: #1a6dff;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.upload-text {
  font-size: 28rpx;
  color: #1a6dff;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

/* 文件信息 */
.file-info {
  background: #f0f7ff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.file-details {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #666;
}

.file-change {
  color: #1a6dff;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #1a6dff;
  border-radius: 8rpx;
}

/* 拆分模式 */
.split-modes {
  margin-bottom: 32rpx;
}

.modes-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.mode-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.mode-tab {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.mode-tab.active {
  background: #1a6dff;
  color: white;
  font-weight: 500;
}

.mode-content {
  background: #fafbfc;
  border-radius: 12rpx;
  padding: 24rpx;
}

.input-group {
  margin-bottom: 16rpx;
}

.input-label {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: white;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea-field {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  background: white;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.mode-hint {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

/* 按钮 */
.split-btn {
  width: 100%;
  background: linear-gradient(135deg, #1a6dff 0%, #0d5cd9 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 0;
}

.split-btn[disabled] {
  background: #ccc;
}

/* 结果区域 */
.result {
  margin-top: 32rpx;
}

.result-header {
  text-align: center;
  padding: 32rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.success-icon {
  font-size: 80rpx;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.result-stats {
  font-size: 24rpx;
  color: #666;
}

.result-stats .dot {
  margin: 0 12rpx;
}

/* 文件列表 */
.files-list {
  margin-bottom: 24rpx;
}

.file-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.file-item-info {
  flex: 1;
  margin-right: 16rpx;
}

.file-item-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-item-meta {
  font-size: 22rpx;
  color: #999;
}

.file-item-meta .dot {
  margin: 0 8rpx;
}

.file-item-btn {
  background: #1a6dff;
  color: white;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.download-all-btn {
  width: 100%;
  background: #52c41a;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.reset-btn {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
}
