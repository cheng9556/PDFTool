.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8f8f8;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 上传区域 */
.upload-area {
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  background: #fafafa;
  margin-bottom: 32rpx;
}

.upload-area:active {
  background: #f0f6ff;
  border-color: #1a6dff;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.upload-text {
  font-size: 28rpx;
  color: #1a6dff;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

/* 文件区域 */
.files-section {
  margin-bottom: 32rpx;
}

.add-file-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #f0f7ff;
  border: 2rpx dashed #1a6dff;
  border-radius: 12rpx;
  color: #1a6dff;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: 300;
}

.file-list {
  margin-bottom: 32rpx;
}

.file-item {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.file-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.file-info {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.file-meta {
  font-size: 24rpx;
  color: #666;
}

.file-actions {
  display: flex;
  gap: 16rpx;
}

.delete-btn {
  color: #ff4d4f;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
}

/* 页面网格 */
.pages-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.page-item {
  position: relative;
  background: #fafbfc;
  border-radius: 12rpx;
  padding: 12rpx;
  border: 2rpx solid #e5e7eb;
  transition: all 0.3s;
}

.page-item.selected {
  border-color: #1a6dff;
  background: #f0f6ff;
  box-shadow: 0 4rpx 12rpx rgba(26, 109, 255, 0.2);
}

.page-thumbnail-wrapper {
  position: relative;
  width: 100%;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: white;
  margin-bottom: 8rpx;
}

.page-thumbnail {
  width: 100%;
  height: 100%;
}

.selected-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: #1a6dff;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 600;
}

.page-number {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

/* 已选择页面区域 */
.selected-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #e8e8e8;
}

.selected-header {
  margin-bottom: 24rpx;
}

.selected-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.selected-hint {
  font-size: 24rpx;
  color: #999;
}

.selected-pages {
  max-height: 600rpx;
  overflow-y: auto;
  margin-bottom: 32rpx;
}

.selected-page-item {
  display: flex;
  align-items: center;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e5e7eb;
}

.selected-page-content {
  flex: 1;
  display: flex;
  align-items: center;
}

.selected-page-thumbnail-wrapper {
  position: relative;
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: white;
  margin-right: 16rpx;
}

.selected-page-thumbnail {
  width: 100%;
  height: 100%;
}

.new-page-number {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  background: #1a6dff;
  color: white;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.selected-page-info {
  flex: 1;
}

.selected-page-filename {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-page-original {
  font-size: 24rpx;
  color: #666;
}

.page-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.move-btn {
  width: 60rpx;
  height: 60rpx;
  background: #1a6dff;
  color: white;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.move-btn.disabled {
  background: #d9d9d9;
  color: #999;
}

.remove-btn {
  width: 60rpx;
  height: 60rpx;
  background: #ff4d4f;
  color: white;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 300;
}

.generate-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1a6dff 0%, #0052d9 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  margin-top: 20rpx;
}

.generate-btn::after {
  border: none;
}

.generate-btn[disabled] {
  background: #d9d9d9;
  color: #999;
}

/* 处理结果 */
.result {
  margin-top: 32rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.success-icon {
  width: 80rpx;
  height: 80rpx;
  background: #52c41a;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  margin: 0 auto 20rpx;
}

.success-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.result-stats {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.dot {
  color: #d9d9d9;
}

.result-file {
  background: #f0f7ff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.file-item-info {
  display: flex;
  flex-direction: column;
}

.file-item-name {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.file-item-meta {
  font-size: 24rpx;
  color: #666;
}

.download-all-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1a6dff 0%, #0052d9 100%);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  margin-bottom: 24rpx;
}

.download-all-btn::after {
  border: none;
}

.reset-btn {
  text-align: center;
  color: #1a6dff;
  font-size: 28rpx;
  padding: 20rpx;
}

