.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8f8f8;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 上传区域 */
.upload-area {
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  background: #fafafa;
  margin-bottom: 32rpx;
  transition: all 0.3s;
}

.upload-area:active {
  background: #f0f6ff;
  border-color: #1a6dff;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.upload-text {
  font-size: 28rpx;
  color: #1a6dff;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

/* 文件信息 */
.file-info {
  background: #f0f7ff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.file-details {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #666;
}

.file-change {
  color: #1a6dff;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #1a6dff;
  border-radius: 8rpx;
}

/* 页面管理区域 */
.pages-section {
  margin-bottom: 32rpx;
}

/* 页面网格（每页显示6个，2行3列，自动适应） */
.pages-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
  /* 自动换行，每行3列，最多2行（6个） */
}

.page-item {
  position: relative;
  background: #fafbfc;
  border-radius: 12rpx;
  padding: 12rpx;
  border: 2rpx solid #e5e7eb;
  transition: all 0.3s;
}

.page-item:active {
  transform: scale(0.98);
}

.page-item.selected {
  border-color: #1a6dff;
  background: #f0f6ff;
  box-shadow: 0 4rpx 12rpx rgba(26, 109, 255, 0.2);
}

.page-thumbnail-wrapper {
  position: relative;
  width: 100%;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: white;
  margin-bottom: 8rpx;
}

.page-thumbnail {
  width: 100%;
  height: 100%;
  transition: transform 0.3s;
}

.rotation-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background: #1a6dff;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  font-weight: 600;
}

.page-number {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}

/* 分页控件 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 32rpx 0;
  padding: 20rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}

.page-btn {
  padding: 12rpx 32rpx;
  background: #1a6dff;
  color: white;
  border-radius: 8rpx;
  font-size: 26rpx;
  min-width: 120rpx;
  text-align: center;
}

.page-btn.disabled {
  background: #ccc;
  color: #999;
}

.page-btn:active:not(.disabled) {
  background: #0d5cd9;
}

.page-info {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  min-width: 100rpx;
  text-align: center;
}

/* 旋转按钮 */
.rotate-btn {
  width: 100%;
  background: linear-gradient(135deg, #1a6dff 0%, #0d5cd9 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-top: 24rpx;
}

.rotate-btn[disabled] {
  background: #ccc;
}

/* 结果区域 */
.result {
  margin-top: 32rpx;
}

.result-header {
  text-align: center;
  padding: 32rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.success-icon {
  font-size: 80rpx;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.result-stats {
  font-size: 24rpx;
  color: #666;
}

.result-stats .dot {
  margin: 0 12rpx;
}

/* 结果文件 */
.result-file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.file-item-info {
  flex: 1;
  margin-right: 16rpx;
}

.file-item-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-item-meta {
  font-size: 22rpx;
  color: #999;
}

.download-all-btn {
  width: 100%;
  background: #52c41a;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.reset-btn {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 旋转角度选择器 */
.angle-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.angle-picker {
  width: 100%;
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.angle-picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.angle-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.angle-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f8f9fa;
  transition: all 0.3s;
}

.angle-option:active {
  background: #e9ecef;
  transform: scale(0.95);
}

.angle-icon {
  font-size: 48rpx;
  color: #1a6dff;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.angle-label {
  font-size: 24rpx;
  color: #666;
}

.angle-picker-cancel {
  text-align: center;
  padding: 24rpx;
  font-size: 28rpx;
  color: #666;
  border-top: 1rpx solid #e5e7eb;
  margin-top: 16rpx;
}
