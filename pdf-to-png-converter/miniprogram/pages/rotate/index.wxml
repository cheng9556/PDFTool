<view class="container">
  <view class="section">
    <view class="title">PDF页面旋转</view>
    <view class="desc">选择页面并设置旋转角度（0°/90°/180°/270°）</view>
    
    <!-- 文件选择 -->
    <view wx:if="{{!fileName}}" class="upload-area" bindtap="choosePdf">
      <image class="upload-icon" src="data:image/svg+xml;base64,"></image>
      <view class="upload-text">点击选择PDF文件</view>
      <view class="upload-hint">支持PDF格式，最大50MB</view>
    </view>
    
    <!-- 已选文件信息 -->
    <view wx:if="{{fileName}}" class="file-info">
      <view class="file-details">
        <text class="file-name">📄 {{fileName}}</text>
        <text class="file-size">{{fileSizeFormatted}}<text wx:if="{{totalPages > 0}}"> • 共{{totalPages}}页</text></text>
      </view>
      <view class="file-change" bindtap="resetFile">更换</view>
    </view>
    
    <!-- 页面预览和旋转 -->
    <view wx:if="{{fileName && !processComplete}}" class="pages-section">
      <!-- 页面缩略图网格（每页显示6个，2行3列） -->
      <view class="pages-grid">
        <block wx:for="{{displayPages}}" wx:key="pageNumber" wx:for-item="page" wx:for-index="displayIndex">
          <view 
            class="page-item {{selectedPageIndex === (currentPage - 1) * pageSize + displayIndex ? 'selected' : ''}}"
            bindtap="selectPage"
            data-index="{{displayIndex}}"
          >
            <view class="page-thumbnail-wrapper">
              <image 
                class="page-thumbnail" 
                src="{{page.thumbnail}}" 
                mode="aspectFit"
                style="transform: rotate({{page.rotation}}deg);"
              ></image>
              <view wx:if="{{rotationMap[page.pageNumber] && rotationMap[page.pageNumber] !== 0}}" class="rotation-badge">
                {{rotationMap[page.pageNumber]}}°
              </view>
            </view>
            <view class="page-number">第{{page.pageNumber}}页</view>
          </view>
        </block>
      </view>
      
      <!-- 分页控件 -->
      <view wx:if="{{totalPages > pageSize && totalPageCount > 1}}" class="pagination">
        <view 
          class="page-btn {{currentPage === 1 ? 'disabled' : ''}}"
          bindtap="goToPrevPage"
        >
          上一页
        </view>
        <view class="page-info">
          <text>{{currentPage}} / {{totalPageCount}}</text>
        </view>
        <view 
          class="page-btn {{currentPage === totalPageCount ? 'disabled' : ''}}"
          bindtap="goToNextPage"
        >
          下一页
        </view>
      </view>
        
      <!-- 旋转按钮 -->
      <button 
        class="rotate-btn"
        bindtap="startRotate"
        disabled="{{processing || Object.keys(rotationMap).length === 0}}"
        loading="{{processing}}"
      >
        {{processing ? '旋转中...' : '开始旋转'}}
      </button>
    </view>
    
    <!-- 处理结果 -->
    <view wx:if="{{processComplete}}" class="result">
      <view class="result-header">
        <view class="success-icon">✓</view>
        <view class="success-text">旋转成功！</view>
        <view class="result-stats">
          <text>旋转了 {{processResult.rotated_pages}} 页</text>
          <text class="dot">•</text>
          <text>耗时 {{processResult.processing_time}}秒</text>
        </view>
      </view>
      
      <view class="result-file">
        <view class="file-item-info">
          <view class="file-item-name">📄 {{processResult.filename}}</view>
          <view class="file-item-meta">
            <text>{{processResult.file_size_mb}} MB</text>
          </view>
        </view>
      </view>
      
      <button class="download-all-btn" bindtap="downloadResult">
        下载旋转后的文件
      </button>
      
      <view class="reset-btn" bindtap="resetFile">
        重新处理
      </view>
    </view>
  </view>
  
  <!-- 旋转角度选择器（底部弹出） -->
  <view wx:if="{{showAnglePicker}}" class="angle-picker-mask" bindtap="closeAnglePicker">
    <view class="angle-picker" catchtap="">
      <view class="angle-picker-title">选择旋转角度</view>
      <view class="angle-options">
        <view 
          wx:for="{{angleOptions}}" 
          wx:key="value"
          class="angle-option"
          bindtap="selectAngle"
          data-angle="{{item.value}}"
        >
          <view class="angle-icon">{{item.label}}</view>
          <view class="angle-label">{{item.label}}</view>
        </view>
      </view>
      <view class="angle-picker-cancel" bindtap="closeAnglePicker">取消</view>
    </view>
  </view>
</view>
