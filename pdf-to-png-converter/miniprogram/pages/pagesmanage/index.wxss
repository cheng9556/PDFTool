.container {
  padding: 24rpx;
  min-height: 100vh;
  background: #f8f8f8;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

/* 上传区域 */
.upload-area {
  border: 2rpx dashed #d9d9d9;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  background: #fafafa;
  margin-bottom: 32rpx;
  transition: all 0.3s;
}

.upload-area:active {
  background: #f0f6ff;
  border-color: #1a6dff;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.upload-text {
  font-size: 28rpx;
  color: #1a6dff;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
}

/* 文件信息 */
.file-info {
  background: #f0f7ff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.file-details {
  flex: 1;
}

.file-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  font-size: 24rpx;
  color: #666;
}

.file-change {
  color: #1a6dff;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #1a6dff;
  border-radius: 8rpx;
}

/* 页面管理区域 */
.pages-section {
  margin-bottom: 32rpx;
}

/* 页面网格 */
.pages-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0;
  width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
}

.page-item {
  position: relative;
  background: #fafbfc;
  border-radius: 12rpx;
  padding: 12rpx;
  border: 2rpx solid #e5e7eb;
  transition: all 0.3s;
}


.page-thumbnail {
  width: 100%;
  height: 120rpx;
  border-radius: 8rpx;
  background: white;
  margin-bottom: 8rpx;
  object-fit: contain;
}

/* 插入图片预览缩小 */
.insert-preview .page-thumbnail {
  height: 80rpx;
  max-height: 80rpx;
}

.page-number {
  font-size: 22rpx;
  color: #666;
  text-align: center;
  margin-bottom: 8rpx;
}

.page-actions {
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.page-action {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #1a6dff;
  color: white;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.page-action.delete {
  background: #ff4d4f;
}

.page-action.insert {
  background: #52c41a;
  font-size: 28rpx;
  font-weight: bold;
}


.insert-btn {
  border-style: dashed;
  border-color: #1a6dff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.insert-icon {
  font-size: 60rpx;
  color: #1a6dff;
  margin-bottom: 8rpx;
}

.insert-preview {
  border-color: #52c41a;
  border-style: solid;
}

/* 分页控件 */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 32rpx 0;
  padding: 20rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}

.page-btn {
  padding: 12rpx 32rpx;
  background: #1a6dff;
  color: white;
  border-radius: 8rpx;
  font-size: 26rpx;
  min-width: 120rpx;
  text-align: center;
}

.page-btn.disabled {
  background: #ccc;
  color: #999;
}

.page-btn:active:not(.disabled) {
  background: #0d5cd9;
}

.page-info {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  min-width: 100rpx;
  text-align: center;
}

/* 按钮 */
.manage-btn {
  width: 100%;
  background: linear-gradient(135deg, #1a6dff 0%, #0d5cd9 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 0;
}

.manage-btn[disabled] {
  background: #ccc;
}

