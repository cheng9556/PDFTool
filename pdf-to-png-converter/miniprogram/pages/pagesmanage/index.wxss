.page-info {
  font-size: 26rpx;
  color: #666;
}

/* 结果区域 */
.result {
  margin-top: 32rpx;
}

.result-header {
  text-align: center;
  padding: 32rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.success-icon {
  font-size: 80rpx;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.success-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.result-stats {
  font-size: 24rpx;
  color: #666;
}

.result-stats .dot {
  margin: 0 12rpx;
}

/* 结果文件 */
.result-file {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.file-item-info {
  flex: 1;
  margin-right: 16rpx;
}

.file-item-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-item-meta {
  font-size: 22rpx;
  color: #999;
}

.file-item-btn {
  background: #1a6dff;
  color: white;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.download-all-btn {
  width: 100%;
  background: #52c41a;
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.reset-btn {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
}
